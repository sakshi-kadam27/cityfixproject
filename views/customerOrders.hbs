<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Your Bookings</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #f9f9f9;
      margin: 0;
      padding: 40px;
    }

    h2 {
      text-align: center;
      color: #0d47a1;
      margin-bottom: 30px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background-color: white;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    th,
    td {
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }

    th {
      background-color: #0d47a1;
      color: white;
    }

    tr:hover {
      background-color: #f1f1f1;
    }

    .status {
      text-transform: capitalize;
      font-weight: bold;
    }

    .status.pending {
      color: orange;
    }

    .status.accepted {
      color: green;
    }

    .status.rejected {
      color: red;
    }

    .message {
      text-align: center;
      margin-top: 20px;
      font-size: 1.2rem;
      color: #333;
    }
    .star-rating {
  display: flex;
  gap: 4px;
  cursor: pointer;
}

.star {
  font-size: 1.2rem;
  color: #ccc;
  transition: color 0.2s;
}

.star:hover,
.star:hover ~ .star {
  color: #ffc107;
}

  </style>
</head>

<body>

  <h2>Your Bookings</h2>

  <div class="message" id="message">Loading...</div>

  <table id="bookings-table" style="display:none;">
    <thead>
      <tr>
        <th>Service</th>
        <th>Date</th>
        <th>Time</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody id="bookings-body">
      <!-- Bookings will be injected here -->
    </tbody>
  </table>

  <script>
    async function fetchBookings() {
      try {
        const response = await fetch("http://localhost:5000/auth/getCustomerOrders");
        const data = await response.json();

        const message = document.getElementById("message");
        const table = document.getElementById("bookings-table");
        const tbody = document.getElementById("bookings-body");

        if (!data.success || !data.orders.length) {
          message.textContent = "No bookings found.";
          return;
        }

        // Hide loading message
        message.style.display = "none";
        table.style.display = "table";

        data.orders.forEach(order => {
          const row = document.createElement("tr");

          const ratingId = `rating-${order.id}`; // Ensure unique ID per row

          row.innerHTML = `
    <td>${order.name_of_service}</td>
    <td>${order.date}</td>
    <td>${order.time}</td>
    <td><span class="status ${order.status}">${order.status}</span></td>
    <td>
      ${order.status === "work_done" ? `
    <div class="star-rating" data-id="${order.id}">
      ${[1, 2, 3, 4, 5].map(star => `
        <span data-star="${star}" class="star">&#9733;</span>
      `).join('')}
    </div>
  ` : ''}
    </td>
    <td>
      <button class="submit-rating-btn" data-id="${order.id}">Submit</button>
    </td>
  `;

          tbody.appendChild(row);
        });


document.addEventListener("click", function(e) {
  // Handle star click
  if (e.target.classList.contains("star")) {
    const star = e.target;
    const ratingContainer = star.parentElement;
    const stars = ratingContainer.querySelectorAll(".star");
    const selectedRating = parseInt(star.getAttribute("data-star"));

    stars.forEach(s => {
      s.style.color = parseInt(s.getAttribute("data-star")) <= selectedRating ? "#ffc107" : "#ccc";
    });

    // Store rating on the container element
    ratingContainer.setAttribute("data-rating", selectedRating);
  }

  // Handle submit button
  if (e.target.classList.contains("submit-rating-btn")) {
    const bookingId = e.target.getAttribute("data-id");
    const ratingContainer = document.querySelector(`.star-rating[data-id="${bookingId}"]`);
    const rating = ratingContainer.getAttribute("data-rating");

    if (!rating) {
      alert("Please select a rating before submitting.");
      return;
    }

    fetch("http://localhost:5000/auth/customerRateBooking", {
      method: "PATCH",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        bookingId: bookingId,
        rating: rating
      })

    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        alert("Rating submitted successfully!");
        // Optionally disable further edits
        e.target.disabled = true;
      } else {
        alert("Failed to submit rating.");
      }
    })
    .catch(err => {
      console.error("Rating error:", err);
      alert("Something went wrong.");
    });
  }
});

      } catch (error) {
        console.error("Error fetching bookings:", error);
        document.getElementById("message").textContent = "Failed to load bookings.";
      }
    }

    window.onload = fetchBookings;
  </script>

</body>

</html>